# Base URL of the zoiko-hr-platform backend that the public chat widget calls.
# Production: https://api.zoikohr.com — that backend's CORS_ORIGINS already
# includes zoikohr.com/www.zoikohr.com (backend/app/config.py), so no other
# config is needed there once this site is actually deployed at that domain.
# For local dev, point this at a locally-running backend instead:
NEXT_PUBLIC_ASSISTANT_API_URL=http://localhost:8000

# Production value (uncomment when deploying):
# NEXT_PUBLIC_ASSISTANT_API_URL=https://api.zoikohr.com

# Public chatbot destinations (Chatbot Wireframe v1.0 §9.2). Unset = the
# default shown; set to an empty value to hide that link entirely — the
# widget then falls back (e.g. "Book a demo" becomes "Contact sales")
# instead of rendering a dead CTA.
# NEXT_PUBLIC_CHAT_BOOKING_URL=/book-a-demo
# NEXT_PUBLIC_CHAT_CONTACT_SALES_URL=/contact-sales
# NEXT_PUBLIC_CHAT_CONTACT_SUPPORT_URL=/contact-support
# NEXT_PUBLIC_CHAT_PRIVACY_URL=/privacy-notice
